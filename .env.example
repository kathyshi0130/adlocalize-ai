# Required: secret model key. Never add this to the frontend HTML or GitHub.
OPENAI_API_KEY=replace_with_your_secret_key

# OpenAI-compatible API base URL. Keep /v1 or the provider's compatible-mode/v1 suffix.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Comma-separated exact allowed browser origins. Replace with your Vercel production URL.
# For local testing with `python -m http.server 8080`, include http://localhost:8080.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Optional shared access password. Leave empty to disable the shared-password gate.
# Note: use real authentication for a commercial multi-user app; a shared password is only a basic gate.
APP_ACCESS_PASSWORD=

# Server request/model timeouts and public API rate limit.
MODEL_TIMEOUT_MS=55000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
PORT=3000
